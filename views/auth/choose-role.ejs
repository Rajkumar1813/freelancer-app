<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Select Account Type - FreelanceHub' %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      min-height: 100vh;
      background: var(--bg-body, #0a0a14);
      color: var(--text-primary, #fff);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      position: relative;
      overflow-x: hidden;
    }
    .bg-grid {
      position: fixed; inset: 0;
      background-image:
        linear-gradient(rgba(108, 99, 255, 0.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(108, 99, 255, 0.06) 1px, transparent 1px);
      background-size: 40px 40px;
      pointer-events: none; z-index: 0;
    }
    .ambient-glow {
      position: fixed; width: 600px; height: 600px; border-radius: 50%;
      background: radial-gradient(circle, rgba(108, 99, 255, 0.14) 0%, transparent 70%);
      top: -200px; right: -150px; pointer-events: none; z-index: 0;
    }
    .ambient-glow-bl {
      position: fixed; width: 500px; height: 500px; border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 210, 255, 0.10) 0%, transparent 70%);
      bottom: -150px; left: -100px; pointer-events: none; z-index: 0;
    }
    .container {
      position: relative; z-index: 1;
      width: 100%; max-width: 820px;
      margin: 0 auto;
    }
    .header-box {
      text-align: center;
      margin-bottom: 32px;
    }
    .user-greeting {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 6px 16px 6px 8px;
      background: rgba(108, 99, 255, 0.12);
      border: 1px solid rgba(108, 99, 255, 0.25);
      border-radius: 50px;
      font-size: 0.88rem;
      margin-bottom: 16px;
    }
    .user-greeting img {
      width: 28px; height: 28px; border-radius: 50%; object-fit: cover;
    }
    .header-box h1 {
      font-size: 2.1rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 8px;
      background: linear-gradient(135deg, #ffffff 40%, rgba(255,255,255,0.7) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .header-box p {
      color: rgba(255, 255, 255, 0.6);
      font-size: 1rem;
      max-width: 520px;
      margin: 0 auto;
    }

    /* Cards Grid */
    .roles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 22px;
      margin-bottom: 28px;
    }
    .role-card {
      position: relative;
      background: rgba(255, 255, 255, 0.04);
      border: 2px solid rgba(255, 255, 255, 0.09);
      border-radius: 20px;
      padding: 32px 26px;
      cursor: pointer;
      transition: all 0.28s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      user-select: none;
      backdrop-filter: blur(16px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }
    .role-card:hover {
      transform: translateY(-4px);
      border-color: rgba(108, 99, 255, 0.4);
      background: rgba(255, 255, 255, 0.06);
      box-shadow: 0 16px 40px rgba(108, 99, 255, 0.15);
    }
    .role-card.selected {
      border-color: #6c63ff;
      background: rgba(108, 99, 255, 0.09);
      box-shadow: 0 0 0 1px #6c63ff, 0 20px 45px rgba(108, 99, 255, 0.25);
    }
    .role-radio {
      position: absolute;
      top: 22px; right: 22px;
      width: 22px; height: 22px;
      border-radius: 50%;
      border: 2px solid rgba(255, 255, 255, 0.25);
      display: flex; align-items: center; justify-content: center;
      transition: all 0.2s;
    }
    .role-card.selected .role-radio {
      border-color: #6c63ff;
      background: #6c63ff;
    }
    .role-radio i {
      color: #fff;
      font-size: 0.72rem;
      opacity: 0;
      transform: scale(0.5);
      transition: all 0.2s;
    }
    .role-card.selected .role-radio i {
      opacity: 1;
      transform: scale(1);
    }
    .role-icon-wrap {
      width: 62px; height: 62px;
      border-radius: 16px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.7rem;
      margin-bottom: 20px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.25);
    }
    .icon-client {
      background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%);
      color: #fff;
    }
    .icon-freelancer {
      background: linear-gradient(135deg, #6c63ff 0%, #a855f7 100%);
      color: #fff;
    }
    .role-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: #fff;
      margin-bottom: 8px;
    }
    .role-desc {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 20px;
    }
    .role-features {
      list-style: none;
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .role-features li {
      font-size: 0.84rem;
      color: rgba(255, 255, 255, 0.75);
      display: flex;
      align-items: center;
      gap: 9px;
    }
    .role-features li i {
      color: #10b981;
      font-size: 0.85rem;
    }

    /* Action bar */
    .submit-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .continue-btn {
      width: 100%;
      max-width: 420px;
      padding: 15px 32px;
      border-radius: 12px;
      border: none;
      background: linear-gradient(135deg, #6c63ff 0%, #764ba2 100%);
      color: #fff;
      font-size: 1.05rem;
      font-weight: 700;
      letter-spacing: 0.2px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 10px 28px rgba(108, 99, 255, 0.4);
      transition: all 0.25s;
    }
    .continue-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 14px 34px rgba(108, 99, 255, 0.55);
    }
    .continue-btn:active {
      transform: translateY(0);
    }
    .disclaimer {
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.4);
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="bg-grid"></div>
  <div class="ambient-glow"></div>
  <div class="ambient-glow-bl"></div>

  <%- include('../partials/flash') %>

  <div class="container">
    <div class="header-box">
      <% if (user) { %>
        <div class="user-greeting">
          <img src="<%= user.googleAvatar || '/avatar/' + user._id %>" onerror="this.src='/images/default-avatar.png'" alt="">
          <span>Signed in as <strong><%= user.name %></strong> (<%= user.email %>)</span>
        </div>
      <% } %>
      <h1>Join FreelanceHub as a Client or Freelancer</h1>
      <p>Choose your primary role. This customizes your dashboard and features.</p>
    </div>

    <form action="/auth/choose-role" method="POST" id="roleForm">
      <input type="hidden" name="role" id="selectedRoleInput" value="freelancer">

      <div class="roles-grid">
        <!-- Freelancer Card -->
        <div class="role-card selected" id="cardFreelancer" onclick="selectRole('freelancer')">
          <div class="role-radio"><i class="fas fa-check"></i></div>
          <div class="role-icon-wrap icon-freelancer">
            <i class="fas fa-laptop-code"></i>
          </div>
          <h2 class="role-title">I'm a Freelancer</h2>
          <p class="role-desc">I want to find freelance work, showcase my portfolio, and get paid securely for my skills.</p>
          <ul class="role-features">
            <li><i class="fas fa-check-circle"></i> Browse and apply to thousands of jobs</li>
            <li><i class="fas fa-check-circle"></i> Submit customized proposals & bids</li>
            <li><i class="fas fa-check-circle"></i> Direct chat and daily progress reports</li>
            <li><i class="fas fa-check-circle"></i> Fast, guaranteed payments with Escrow</li>
          </ul>
        </div>

        <!-- Client Card -->
        <div class="role-card" id="cardClient" onclick="selectRole('client')">
          <div class="role-radio"><i class="fas fa-check"></i></div>
          <div class="role-icon-wrap icon-client">
            <i class="fas fa-briefcase"></i>
          </div>
          <h2 class="role-title">I'm a Client</h2>
          <p class="role-desc">I want to post projects, hire top vetted talent, manage deliverables, and scale my business.</p>
          <ul class="role-features">
            <li><i class="fas fa-check-circle"></i> Post projects and receive bids quickly</li>
            <li><i class="fas fa-check-circle"></i> Compare freelancer portfolios & ratings</li>
            <li><i class="fas fa-check-circle"></i> Track daily reports & project milestones</li>
            <li><i class="fas fa-check-circle"></i> Safe Razorpay payments released upon approval</li>
          </ul>
        </div>
      </div>

      <div class="submit-wrap">
        <button type="submit" class="continue-btn" id="continueBtn">
          <span>Continue as Freelancer</span>
          <i class="fas fa-arrow-right"></i>
        </button>
        <p class="disclaimer">You can adjust profile details anytime from account settings.</p>
      </div>
    </form>
  </div>

  <script>
    function selectRole(role) {
      document.getElementById('selectedRoleInput').value = role;
      const cardFreelancer = document.getElementById('cardFreelancer');
      const cardClient = document.getElementById('cardClient');
      const continueBtn = document.getElementById('continueBtn');

      if (role === 'freelancer') {
        cardFreelancer.classList.add('selected');
        cardClient.classList.remove('selected');
        continueBtn.innerHTML = '<span>Continue as Freelancer</span> <i class="fas fa-arrow-right"></i>';
      } else {
        cardClient.classList.add('selected');
        cardFreelancer.classList.remove('selected');
        continueBtn.innerHTML = '<span>Continue as Client</span> <i class="fas fa-arrow-right"></i>';
      }
    }
  </script>
</body>
</html>
