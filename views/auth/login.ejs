<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Login - FreelanceHub' %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    .admin-switch-link {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px dashed var(--border);
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-muted);
    }
    .admin-switch-link a {
      color: var(--primary);
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
  </style>
</head>
<body class="auth-body">
  <%- include('../partials/flash') %>
  <div class="auth-container">
    <div class="auth-left">
      <div class="auth-brand">
        <span class="brand-icon-lg">⚡</span>
        <h1>FreelanceHub</h1>
        <p>Connect. Create. Collaborate.</p>
      </div>
      <div class="auth-features">
        <div class="feature-item"><i class="fas fa-check-circle"></i> Hire verified elite freelancers</div>
        <div class="feature-item"><i class="fas fa-check-circle"></i> Post & manage projects effortlessly</div>
        <div class="feature-item"><i class="fas fa-check-circle"></i> Real-time socket messaging & chat</div>
        <div class="feature-item"><i class="fas fa-check-circle"></i> Secure Razorpay escrow payments</div>
      </div>
    </div>

    <div class="auth-right">
      <div class="auth-card">
        <h2>Welcome Back</h2>
        <p class="auth-subtitle">Login to your FreelanceHub account</p>

        <% if (locals.showUnverifiedMsg) { %>
        <div style="background:rgba(245,158,11,0.12);border:1px solid rgba(245,158,11,0.3);border-radius:10px;
                    padding:12px 14px;margin-bottom:18px;font-size:0.84rem;color:#b45309;">
          <p style="margin:0;font-weight:700;">
            <i class="fas fa-envelope-open-text" style="margin-right:5px;"></i>
            OTP sent to your email address!
          </p>
          <p style="margin:6px 0 0;line-height:1.5;">
            Your account is not verified yet. Please check your inbox and
            <strong>enter the OTP</strong> to activate your profile.
          </p>
        </div>
        <% } %>

        <form action="/auth/login" method="POST" class="auth-form">
          <div class="form-group">
            <label><i class="fas fa-envelope"></i> Email Address</label>
            <input type="email" name="email" placeholder="you@domain.com"
                   required class="form-input" autocomplete="email">
          </div>
          <div class="form-group">
            <label style="display:flex;justify-content:space-between;align-items:center;">
              <span><i class="fas fa-lock"></i> Password</span>
              <a href="/auth/forgot-password"
                 style="font-size:0.8rem;font-weight:600;color:var(--primary);">
                Forgot Password?
              </a>
            </label>
            <div class="input-with-icon">
              <input type="password" name="password" id="loginPassword"
                     placeholder="••••••••" required class="form-input" autocomplete="current-password">
              <button type="button" class="toggle-password"
                      onclick="togglePass('loginPassword')">
                <i class="fas fa-eye" id="loginPasswordIcon"></i>
              </button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-full btn-lg">
            <i class="fas fa-sign-in-alt"></i> Login
          </button>
        </form>

        <div class="auth-divider"><span>or continue with</span></div>
        <a href="/auth/google" class="btn btn-google btn-full">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
               alt="Google" width="20">
          Continue with Google
        </a>

        <p class="auth-switch">
          Don't have an account? <a href="/auth/register">Register here</a>
        </p>

        <div class="admin-switch-link">
          Administrator? <a href="/auth/admin/login"><i class="fas fa-shield-halved"></i> Admin Control Panel</a>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
