<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Register - FreelanceHub' %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    .admin-switch-link {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px dashed var(--border);
      text-align: center;
      font-size: 0.82rem;
      color: var(--text-muted);
    }
    .admin-switch-link a {
      color: var(--primary);
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .strength-meter {
      height: 4px;
      background: var(--border);
      border-radius: 2px;
      margin-top: 6px;
      overflow: hidden;
    }
    .strength-meter-bar {
      height: 100%;
      width: 0;
      transition: all 0.3s ease;
    }
  </style>
</head>
<body class="auth-body">
  <%- include('../partials/flash') %>
  <div class="auth-container">
    <div class="auth-left">
      <div class="auth-brand">
        <span class="brand-icon-lg">⚡</span>
        <h1>FreelanceHub</h1>
        <p>Your freelancing career starts here</p>
      </div>
      <div class="role-info">
        <div class="role-card" id="clientInfo">
          <i class="fas fa-building"></i>
          <h3>Client</h3>
          <p>Post projects, hire verified freelancers, track deliverables & milestones.</p>
        </div>
        <div class="role-card" id="freelancerInfo">
          <i class="fas fa-laptop-code"></i>
          <h3>Freelancer</h3>
          <p>Showcase skills, submit project proposals, collaborate via chat & earn securely.</p>
        </div>
      </div>
    </div>

    <div class="auth-right">
      <div class="auth-card">
        <h2>Create Account</h2>
        <p class="auth-subtitle">Join thousands of verified clients and professionals</p>

        <form action="/auth/register" method="POST" class="auth-form" id="registerForm">
          <div class="form-group">
            <label><i class="fas fa-user"></i> Full Name</label>
            <input type="text" name="name" placeholder="John Doe" required class="form-input" autocomplete="name">
          </div>

          <div class="form-group">
            <label><i class="fas fa-envelope"></i> Email Address</label>
            <input type="email" name="email" placeholder="you@domain.com" required class="form-input" autocomplete="email">
          </div>

          <div class="form-group">
            <label><i class="fas fa-lock"></i> Password</label>
            <div class="input-with-icon">
              <input type="password" name="password" id="regPassword" placeholder="Min 6 characters"
                     required minlength="6" class="form-input" oninput="checkRegStrength(this.value)" autocomplete="new-password">
              <button type="button" class="toggle-password" onclick="togglePass('regPassword')">
                <i class="fas fa-eye" id="regPasswordIcon"></i>
              </button>
            </div>
            <div class="strength-meter">
              <div class="strength-meter-bar" id="regStrengthBar"></div>
            </div>
          </div>

          <div class="form-group">
            <label><i class="fas fa-users"></i> I want to join as a...</label>
            <div class="role-selector">
              <label class="role-option">
                <input type="radio" name="role" value="client" required checked>
                <div class="role-option-card">
                  <i class="fas fa-building"></i>
                  <span>Client</span>
                  <small>Hiring talent</small>
                </div>
              </label>
              <label class="role-option">
                <input type="radio" name="role" value="freelancer" required>
                <div class="role-option-card">
                  <i class="fas fa-laptop-code"></i>
                  <span>Freelancer</span>
                  <small>Offering skills</small>
                </div>
              </label>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-full btn-lg">
            <i class="fas fa-user-plus"></i> Create Account
          </button>
        </form>

        <div class="auth-divider"><span>or sign up with</span></div>
        <a href="/auth/google" class="btn btn-google btn-full">
          <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" width="20">
          Sign up with Google
        </a>

        <p class="auth-switch">
          Already have an account? <a href="/auth/login">Login here</a>
        </p>

        <div class="admin-switch-link">
          Administrator setup? <a href="/auth/admin/register"><i class="fas fa-shield-halved"></i> Create Admin Account</a>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/theme.js"></script>
  <script>
    function checkRegStrength(val) {
      const bar = document.getElementById('regStrengthBar');
      let score = 0;
      if (val.length >= 6) score++;
      if (val.length >= 10) score++;
      if (/[A-Z]/.test(val) && /[0-9]/.test(val)) score++;
      if (/[^A-Za-z0-9]/.test(val)) score++;

      const colors = ['#ef4444', '#f59e0b', '#3b82f6', '#22c55e'];
      const widths = ['25%', '50%', '75%', '100%'];
      if (val.length === 0) {
        bar.style.width = '0%';
      } else {
        bar.style.width = widths[Math.min(score, 3)];
        bar.style.backgroundColor = colors[Math.min(score, 3)];
      }
    }
  </script>
</body>
</html>
