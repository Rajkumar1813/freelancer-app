<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/chat.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="app-body">
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content chat-main">
      <div class="chat-layout <%= activeConversation ? 'chat-view-active' : 'list-view-active' %>">

        <!-- ===== LEFT: Conversations List ===== -->
        <div class="chat-sidebar">
          <div class="chat-sidebar-header">
            <div class="chat-sidebar-title">
              <h3><i class="fas fa-comment-dots"></i> Messages</h3>
              <span class="conv-count"><%= conversations.length %></span>
            </div>
            <div class="conv-search-box">
              <i class="fas fa-search"></i>
              <input type="text" id="convSearchInput" placeholder="Search conversations..." autocomplete="off">
            </div>
          </div>
          <div class="conv-list" id="convList">
            <% if (conversations.length === 0) { %>
              <div class="conv-empty">
                <div class="conv-empty-icon"><i class="fas fa-comments"></i></div>
                <h4>No conversations yet</h4>
                <p>When you message clients or freelancers, your chats will appear here.</p>
              </div>
            <% } %>
            <% conversations.forEach(conv => {
                const isActive = activeConversation && activeConversation._id.toString() === conv._id.toString();
                const oUser = conv.otherUser;
                const avatar = oUser && oUser.googleAvatar ? oUser.googleAvatar : (oUser ? '/avatar/' + oUser._id : '/images/default-avatar.png');
            %>
            <a href="/messages/<%= conv._id %>"
              class="conv-item <%= isActive ? 'conv-active' : '' %>"
              data-name="<%= oUser ? oUser.name.toLowerCase() : '' %>">
              <div class="conv-avatar-wrap">
                <img
                  src="<%= avatar %>"
                  class="conv-avatar"
                  alt="<%= oUser ? oUser.name : 'User' %>"
                  onerror="this.src='/images/default-avatar.png'">
                <span class="conv-online-dot"></span>
              </div>
              <div class="conv-info">
                <div class="conv-name-row">
                  <span class="conv-name"><%= oUser ? oUser.name : 'Unknown' %></span>
                  <span class="conv-time">
                    <% if (conv.updatedAt) { %>
                      <%= new Date(conv.updatedAt).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'}) %>
                    <% } %>
                  </span>
                </div>
                <div class="conv-role-row">
                  <span class="conv-role badge role-<%= oUser ? oUser.role : '' %>"><%= oUser ? oUser.role : '' %></span>
                </div>
                <div class="conv-last-msg">
                  <%= conv.lastMessage && conv.lastMessage.content
                      ? conv.lastMessage.content.substring(0,38) + (conv.lastMessage.content.length > 38 ? '...' : '')
                      : 'Start a conversation...' %>
                </div>
              </div>
            </a>
            <% }) %>
          </div>
        </div>

        <!-- ===== RIGHT: Chat Window ===== -->
        <div class="chat-window">
          <% if (!activeConversation) { %>
            <div class="chat-empty">
              <div class="chat-empty-art">
                <i class="fas fa-paper-plane"></i>
              </div>
              <h3>Select a Conversation</h3>
              <p>Choose any conversation from the list to view history and start collaborating in real time.</p>
            </div>
          <% } else { %>
            <!-- Chat Header -->
            <div class="chat-header">
              <a href="/messages" class="chat-back-btn" title="Back to conversations">
                <i class="fas fa-arrow-left"></i>
                <span class="back-label">Messages</span>
              </a>
              <div class="chat-header-user">
                <div class="chat-header-avatar-wrap">
                  <img
                    src="<%= otherUser && otherUser.googleAvatar ? otherUser.googleAvatar : (otherUser ? '/avatar/'+otherUser._id : '/images/default-avatar.png') %>"
                    class="chat-header-avatar"
                    alt="<%= otherUser ? otherUser.name : 'User' %>"
                    onerror="this.src='/images/default-avatar.png'">
                  <span class="header-online-dot"></span>
                </div>
                <div class="chat-header-meta">
                  <div class="chat-header-name">
                    <span><%= otherUser ? otherUser.name : 'User' %></span>
                    <% if (otherUser && otherUser.role) { %>
                      <span class="badge role-<%= otherUser.role %>"><%= otherUser.role %></span>
                    <% } %>
                  </div>
                  <div class="chat-header-sub" id="chatStatusText">Active on FreelanceHub</div>
                </div>
              </div>

              <div class="chat-header-actions">
                <div class="typing-indicator" id="typingIndicator" style="display:none">
                  <span></span><span></span><span></span>
                </div>
                <% if (otherUser) { %>
                  <a href="/profile/<%= otherUser._id %>" class="chat-action-btn" title="View Profile">
                    <i class="fas fa-user-circle"></i>
                    <span class="action-btn-text">Profile</span>
                  </a>
                <% } %>
              </div>
            </div>

            <!-- Messages Area -->
            <div class="messages-wrap" id="messagesWrap">
              <% if (messages.length === 0) { %>
                <div class="chat-start-hint">
                  <div class="hint-icon"><i class="fas fa-handshake"></i></div>
                  <h4>Say hello to <%= otherUser ? otherUser.name : 'User' %>!</h4>
                  <p>Send a message below to start coordinating deliverables and updates.</p>
                </div>
              <% } %>
              <% messages.forEach(function(msg) {
                const isOwn = msg.sender && msg.sender._id && msg.sender._id.toString() === currentUser._id.toString();
                const senderAvatar = msg.sender && msg.sender.googleAvatar
                  ? msg.sender.googleAvatar
                  : (msg.sender && msg.sender._id ? '/avatar/' + msg.sender._id : '/images/default-avatar.png');
                const msgTime = new Date(msg.createdAt).toLocaleTimeString('en-IN', {hour:'2-digit', minute:'2-digit'});
              %>
              <div class="message-row <%= isOwn ? 'message-own' : 'message-other' %>"
                data-msg-id="<%= msg._id %>">
                <% if (!isOwn) { %>
                  <img src="<%= senderAvatar %>" class="msg-avatar"
                    onerror="this.src='/images/default-avatar.png'" alt="avatar">
                <% } %>
                <div class="message-bubble">
                  <div class="message-text"><%= msg.content %></div>
                  <div class="message-meta">
                    <span class="message-time"><%= msgTime %></span>
                    <% if (isOwn) { %>
                      <span class="msg-check"><i class="fas fa-check-double"></i></span>
                    <% } %>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>

            <!-- Input Area -->
            <div class="chat-input-area">
              <form id="messageForm" class="message-form" onsubmit="return false;">
                <input
                  type="text"
                  id="messageInput"
                  class="message-input"
                  placeholder="Type a message..."
                  autocomplete="off"
                  value="<%= typeof initMsg !== 'undefined' && initMsg ? initMsg : '' %>"
                  maxlength="2000">
                <button type="button" id="sendBtn" class="send-btn" aria-label="Send message" onclick="document.getElementById('messageForm').dispatchEvent(new Event('submit'))">
                  <i class="fas fa-paper-plane"></i>
                </button>
              </form>
            </div>
          <% } %>
        </div>

      </div>
    </main>
  </div>

  <!-- Pass server data to JS -->
  <script>
    const USER_ID       = '<%= currentUser._id %>';
    const CONV_ID       = '<%= activeConversation ? activeConversation._id.toString() : "" %>';
    const OTHER_USER_ID = '<%= otherUser ? otherUser._id.toString() : "" %>';
    const OTHER_USER_NAME   = '<%= otherUser ? otherUser.name.replace(/'/g, "\\'") : "" %>';
    const OTHER_USER_AVATAR = '<%= otherUser ? (otherUser.googleAvatar || "/avatar/"+otherUser._id) : "" %>';
  </script>
  <script src="/js/main.js"></script>
  <script src="/js/chat.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/theme.js"></script>

  <style>
    .chat-start-hint {
      text-align: center;
      padding: 40px 20px;
      color: var(--text-muted);
      font-size: 0.95rem;
    }
    .chat-start-hint i { font-size: 2rem; display: block; margin-bottom: 10px; }
  </style>
</body>
</html>