<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <!-- Cropper.js CSS -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">
  <script src="/socket.io/socket.io.js"></script>
  <style>
    .avatar-wrapper-rel {
      position: relative;
      display: inline-block;
      border-radius: 50%;
    }
    .avatar-edit-badge {
      position: absolute;
      bottom: 6px;
      right: 6px;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: linear-gradient(135deg, #6c63ff, #764ba2);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      border: 3px solid #1a1a2e;
      box-shadow: 0 4px 14px rgba(0,0,0,0.4);
      transition: all 0.2s ease;
      font-size: 0.95rem;
    }
    .avatar-edit-badge:hover {
      transform: scale(1.12);
      background: linear-gradient(135deg, #584eed, #6a3ea1);
      box-shadow: 0 6px 18px rgba(108, 99, 255, 0.5);
    }
    /* Crop Modal */
    .crop-modal-overlay {
      position: fixed; inset: 0; z-index: 10000;
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(8px);
      display: none; align-items: center; justify-content: center;
      padding: 16px;
    }
    .crop-modal-box {
      background: #141426;
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 20px;
      width: 100%; max-width: 540px;
      box-shadow: 0 24px 60px rgba(0,0,0,0.6);
      overflow: hidden;
      animation: zoomInModal 0.25s ease;
      display: flex; flex-direction: column;
    }
    @keyframes zoomInModal {
      from { transform: scale(0.92); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .crop-modal-header {
      padding: 18px 24px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .crop-modal-header h3 {
      font-size: 1.15rem; font-weight: 700; color: #fff; margin: 0;
      display: flex; align-items: center; gap: 8px;
    }
    .crop-modal-close {
      background: none; border: none; color: rgba(255,255,255,0.5);
      font-size: 1.4rem; cursor: pointer; transition: color 0.2s;
    }
    .crop-modal-close:hover { color: #fff; }
    .crop-area-container {
      height: 340px; width: 100%;
      background: #090912;
      position: relative;
      overflow: hidden;
    }
    .crop-controls {
      display: flex; align-items: center; justify-content: center;
      gap: 10px; padding: 14px 20px;
      background: rgba(255,255,255,0.02);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .crop-btn-tool {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.12);
      color: #fff; border-radius: 8px;
      padding: 7px 12px; font-size: 0.85rem;
      cursor: pointer; transition: all 0.2s;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .crop-btn-tool:hover {
      background: rgba(108, 99, 255, 0.25);
      border-color: #6c63ff;
    }
    .crop-modal-footer {
      padding: 16px 24px;
      display: flex; align-items: center; justify-content: flex-end;
      gap: 12px;
      border-top: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.02);
    }
    /* Circular cropper preview mask */
    .cropper-view-box, .cropper-face {
      border-radius: 50%;
    }
  </style>
</head>
<body class="app-body">
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="profile-hero">
        <div class="profile-hero-bg"></div>
        <div class="profile-hero-content">
          <div class="avatar-wrapper-rel">
            <img src="<%= profileUser.googleAvatar || '/avatar/' + profileUser._id %>"
              class="profile-hero-avatar" id="mainHeroAvatar" onerror="this.src='/images/default-avatar.png'">
            <% if (currentUser && currentUser._id.toString() === profileUser._id.toString()) { %>
              <button type="button" class="avatar-edit-badge" title="Change & Crop Profile Photo" onclick="document.getElementById('avatarFileInput').click()">
                <i class="fas fa-camera"></i>
              </button>
              <input type="file" id="avatarFileInput" accept="image/*" style="display:none" onchange="onAvatarFilePicked(this)">
            <% } %>
          </div>
          <div class="profile-hero-info">
            <h1><%= profileUser.name %></h1>
            <span class="badge role-<%= profileUser.role %> badge-lg"><%= profileUser.role %></span>
            <% if (profileUser.role === 'freelancer') { %>
              <span class="avail-badge avail-<%= profileUser.availability || 'available' %>"><%= (profileUser.availability || 'available').replace('_',' ') %></span>
            <% } %>
            <div class="rating-row rating-lg">
              <% for(let i=1;i<=5;i++) { %><i class="fas fa-star <%= i <= Math.round(profileUser.rating||0) ? 'star-filled':'star-empty' %>"></i><% } %>
              <span>(<%= profileUser.reviewCount || 0 %> reviews)</span>
            </div>
            <% if (profileUser.location) { %><p><i class="fas fa-map-marker-alt"></i> <%= profileUser.location %></p><% } %>
          </div>
          <div class="profile-hero-actions">
            <% if (currentUser && currentUser._id.toString() === profileUser._id.toString()) { %>
              <% if (currentUser.role === 'freelancer') { %>
                <a href="/freelancer/edit-profile" class="btn btn-primary"><i class="fas fa-edit"></i> Edit Profile</a>
              <% } %>
              <button type="button" class="btn btn-outline" onclick="document.getElementById('avatarFileInput').click()">
                <i class="fas fa-crop-alt"></i> Change Photo
              </button>
            <% } else { %>
              <form action="/messages/start" method="POST" style="display:inline">
                <input type="hidden" name="userId" value="<%= profileUser._id %>">
                <button type="submit" class="btn btn-primary"><i class="fas fa-comment"></i> Message</button>
              </form>
            <% } %>
          </div>
        </div>
      </div>

      <div class="profile-body">
        <div class="profile-stats-cards">
          <div class="pstat-card">
            <i class="fas fa-briefcase"></i>
            <div class="pstat-val"><%= profileUser.completedProjects || 0 %></div>
            <div class="pstat-label">Completed Projects</div>
          </div>
          <% if (profileUser.role === 'freelancer') { %>
          <div class="pstat-card">
            <i class="fas fa-rupee-sign"></i>
            <div class="pstat-val">₹<%= (profileUser.totalEarnings||0).toLocaleString('en-IN') %></div>
            <div class="pstat-label">Total Earned</div>
          </div>
          <div class="pstat-card">
            <i class="fas fa-clock"></i>
            <div class="pstat-val"><%= profileUser.hourlyRate ? '₹'+profileUser.hourlyRate+'/hr' : 'N/A' %></div>
            <div class="pstat-label">Hourly Rate</div>
          </div>
          <% } else { %>
          <div class="pstat-card">
            <i class="fas fa-rupee-sign"></i>
            <div class="pstat-val">₹<%= (profileUser.totalSpent||0).toLocaleString('en-IN') %></div>
            <div class="pstat-label">Total Spent</div>
          </div>
          <% } %>
          <div class="pstat-card">
            <i class="fas fa-calendar"></i>
            <div class="pstat-val"><%= new Date(profileUser.createdAt).toLocaleDateString('en-IN', {month:'short', year:'numeric'}) %></div>
            <div class="pstat-label">Member Since</div>
          </div>
        </div>

        <% if (profileUser.bio) { %>
        <div class="profile-section-card"><h3>About</h3><p><%= profileUser.bio %></p></div>
        <% } %>

        <% if (profileUser.role === 'freelancer' && (profileUser.skills||[]).length > 0) { %>
        <div class="profile-section-card">
          <h3>Skills</h3>
          <div class="tags-row tags-lg">
            <% profileUser.skills.forEach(sk => { %><span class="tag tag-lg"><%= sk %></span><% }) %>
          </div>
        </div>
        <% } %>

        <% if (projects.length > 0) { %>
        <div class="profile-section-card">
          <h3><%= profileUser.role === 'freelancer' ? 'Completed Work' : 'Posted Projects' %></h3>
          <div class="mini-projects-list">
            <% projects.forEach(p => { %>
            <div class="mini-project-item">
              <div class="fw-bold"><%= p.title %></div>
              <div class="text-muted small">₹<%= (p.budget||0).toLocaleString('en-IN') %> · <span class="badge status-<%= p.status || 'open' %>"><%= (p.status || 'open').replace('_',' ') %></span></div>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>

        <% if (profileUser.role === 'freelancer' && (profileUser.portfolio||[]).length > 0) { %>
        <div class="profile-section-card">
          <h3>Portfolio</h3>
          <div class="portfolio-grid">
            <% profileUser.portfolio.forEach(item => { %>
            <div class="portfolio-item">
              <h4><%= item.title %></h4>
              <p><%= item.description %></p>
              <% if (item.link) { %><a href="<%= item.link %>" target="_blank" class="btn btn-sm btn-outline">View Project</a><% } %>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>
    </main>
  </div>

  <!-- Avatar Crop Modal -->
  <div class="crop-modal-overlay" id="cropModalOverlay">
    <div class="crop-modal-box">
      <div class="crop-modal-header">
        <h3><i class="fas fa-crop-alt"></i> Crop Your Profile Picture</h3>
        <button type="button" class="crop-modal-close" onclick="closeCropModal()">×</button>
      </div>
      <div class="crop-area-container">
        <img id="imageToCrop" src="" alt="Crop preview" style="max-width:100%; display:block;">
      </div>
      <div class="crop-controls">
        <button type="button" class="crop-btn-tool" onclick="if(cropper)cropper.zoom(0.1)" title="Zoom In">
          <i class="fas fa-search-plus"></i>
        </button>
        <button type="button" class="crop-btn-tool" onclick="if(cropper)cropper.zoom(-0.1)" title="Zoom Out">
          <i class="fas fa-search-minus"></i>
        </button>
        <button type="button" class="crop-btn-tool" onclick="if(cropper)cropper.rotate(-90)" title="Rotate Left">
          <i class="fas fa-undo"></i>
        </button>
        <button type="button" class="crop-btn-tool" onclick="if(cropper)cropper.rotate(90)" title="Rotate Right">
          <i class="fas fa-redo"></i>
        </button>
        <button type="button" class="crop-btn-tool" onclick="if(cropper)cropper.reset()" title="Reset Crop">
          <i class="fas fa-sync-alt"></i> Reset
        </button>
      </div>
      <div class="crop-modal-footer">
        <button type="button" class="btn btn-outline" onclick="closeCropModal()">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveCropBtn" onclick="saveCroppedAvatar()">
          <i class="fas fa-check"></i> Crop & Save Avatar
        </button>
      </div>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/theme.js"></script>
  <!-- Cropper.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script>
    const USER_ID = '<%= currentUser._id %>';
    let cropper = null;

    function onAvatarFilePicked(input) {
      if (!input.files || !input.files[0]) return;
      const file = input.files[0];
      if (!file.type.startsWith('image/')) {
        alert('Please select a valid image file (JPG, PNG, WebP).');
        return;
      }
      const reader = new FileReader();
      reader.onload = function(e) {
        openCropModal(e.target.result);
      };
      reader.readAsDataURL(file);
    }

    function openCropModal(imageSrc) {
      const modal = document.getElementById('cropModalOverlay');
      const img = document.getElementById('imageToCrop');
      modal.style.display = 'flex';
      img.src = imageSrc;

      if (cropper) {
        cropper.destroy();
      }

      // Initialize cropper after image is rendered in modal
      setTimeout(() => {
        cropper = new Cropper(img, {
          aspectRatio: 1,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.85,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          cropBoxMovable: true,
          cropBoxResizable: true,
          toggleDragModeOnDblclick: false,
        });
      }, 50);
    }

    function closeCropModal() {
      const modal = document.getElementById('cropModalOverlay');
      modal.style.display = 'none';
      if (cropper) {
        cropper.destroy();
        cropper = null;
      }
      const fileInput = document.getElementById('avatarFileInput');
      if (fileInput) fileInput.value = '';
    }

    function saveCroppedAvatar() {
      if (!cropper) return;
      const saveBtn = document.getElementById('saveCropBtn');
      const originalText = saveBtn.innerHTML;
      saveBtn.disabled = true;
      saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

      const canvas = cropper.getCroppedCanvas({
        width: 400,
        height: 400,
        imageSmoothingQuality: 'high'
      });

      const base64Data = canvas.toDataURL('image/jpeg', 0.9);

      fetch('/profile/avatar', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ avatarBase64: base64Data })
      })
      .then(res => res.json())
      .then(data => {
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        if (data.success) {
          // Update main hero avatar
          const heroAvatar = document.getElementById('mainHeroAvatar');
          if (heroAvatar) heroAvatar.src = data.avatarUrl;

          // Update header and sidebar avatars
          document.querySelectorAll('.nav-avatar, .sidebar-avatar').forEach(img => {
            img.src = data.avatarUrl;
          });

          closeCropModal();

          // Show floating flash or alert
          const notif = document.createElement('div');
          notif.className = 'flash flash-success';
          notif.style.position = 'fixed';
          notif.style.top = '20px';
          notif.style.right = '20px';
          notif.style.zIndex = '99999';
          notif.innerHTML = '<i class="fas fa-check-circle"></i> Profile photo cropped and updated successfully! <button class="flash-close" onclick="this.parentElement.remove()">×</button>';
          document.body.appendChild(notif);
          setTimeout(() => notif.remove(), 4000);
        } else {
          alert(data.message || 'Failed to update avatar');
        }
      })
      .catch(err => {
        console.error('Avatar upload error:', err);
        saveBtn.disabled = false;
        saveBtn.innerHTML = originalText;
        alert('An error occurred while uploading your cropped photo.');
      });
    }
  </script>
</body>
</html>