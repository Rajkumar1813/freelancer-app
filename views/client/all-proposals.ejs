<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>

  <style>
    .proposals-hub-wrap {
      display: flex;
      flex-direction: column;
      gap: 20px;
      width: 100%;
    }

    /* ── Proposal Hub Cards ────────────────────────────────────────── */
    .prop-hub-grid {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .prop-hub-card {
      background: var(--bg-card, #ffffff);
      border: 1px solid var(--border, #e2e8f0);
      border-radius: var(--radius-md, 14px);
      padding: 20px;
      box-shadow: var(--shadow-sm);
      transition: all 0.2s ease;
      display: flex;
      flex-direction: column;
      gap: 14px;
      position: relative;
    }
    .prop-hub-card:hover {
      box-shadow: var(--shadow-md);
      border-color: rgba(108, 99, 255, 0.3);
    }
    .prop-hub-card.card-accepted {
      border-left: 4px solid #16a34a;
      background: linear-gradient(to right, rgba(34, 197, 94, 0.03), var(--bg-card));
    }
    .prop-hub-card.card-rejected {
      opacity: 0.8;
      border-left: 4px solid #ef4444;
    }

    .prop-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 14px;
      flex-wrap: wrap;
      border-bottom: 1px solid var(--border-light, #f1f5f9);
      padding-bottom: 12px;
    }

    .prop-project-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(108, 99, 255, 0.1);
      color: var(--primary, #6c63ff);
      font-weight: 700;
      font-size: 0.82rem;
      padding: 5px 12px;
      border-radius: 20px;
      text-decoration: none;
      transition: background 0.15s;
    }
    .prop-project-badge:hover {
      background: rgba(108, 99, 255, 0.2);
    }

    .prop-meta-badges {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .prop-body-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 18px;
      align-items: center;
    }

    .freelancer-profile-row {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .freelancer-avatar {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--border, #e2e8f0);
      flex-shrink: 0;
    }
    .freelancer-meta-info {
      display: flex;
      flex-direction: column;
      gap: 3px;
      min-width: 0;
    }
    .freelancer-name {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--text-primary);
      text-decoration: none;
    }
    .freelancer-name:hover {
      color: var(--primary);
    }

    .prop-bid-box {
      background: var(--secondary, #f0f4ff);
      padding: 12px 18px;
      border-radius: 12px;
      text-align: right;
      display: flex;
      flex-direction: column;
      gap: 3px;
      flex-shrink: 0;
    }
    .prop-bid-val {
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--primary);
      line-height: 1.1;
    }
    .prop-bid-time {
      font-size: 0.78rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .prop-cover-letter {
      background: var(--bg-main, #f8fafc);
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid var(--border-light, #f1f5f9);
      font-size: 0.88rem;
      color: var(--text-secondary);
      line-height: 1.5;
    }
    .prop-cover-letter h5 {
      font-size: 0.76rem;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 4px;
      letter-spacing: 0.05em;
    }

    .prop-actions-bar {
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      padding-top: 6px;
    }

    @media (max-width: 768px) {
      .prop-body-grid {
        grid-template-columns: 1fr;
      }
      .prop-bid-box {
        text-align: left;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
      }
      .prop-actions-bar {
        justify-content: stretch;
      }
      .prop-actions-bar a,
      .prop-actions-bar form,
      .prop-actions-bar button {
        flex: 1;
        text-align: center;
      }
    }
  </style>
</head>
<body class="app-body">
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <div class="app-layout">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
      <div class="proposals-hub-wrap">

        <!-- ── Page Header ──────────────────────────────────────────── -->
        <div class="page-header">
          <div>
            <h1 class="page-title">
              <i class="fas fa-paper-plane" style="color:var(--primary);"></i> Project Proposals
            </h1>
            <p class="page-subtitle">Review, compare, and accept proposals submitted by freelancers across all your projects</p>
          </div>
          <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <a href="/client/my-projects" class="btn btn-outline"><i class="fas fa-folder-open"></i> My Projects</a>
            <a href="/client/post-project" class="btn btn-primary"><i class="fas fa-plus"></i> Post New Project</a>
          </div>
        </div>

        <!-- ── KPI Counter Cards ────────────────────────────────────── -->
        <div class="stats-grid" style="grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));">
          <div class="stat-card stat-purple">
            <div class="stat-icon"><i class="fas fa-inbox"></i></div>
            <div class="stat-info">
              <div class="stat-value"><%= stats.total %></div>
              <div class="stat-label">Total Received</div>
            </div>
          </div>
          <div class="stat-card stat-orange">
            <div class="stat-icon"><i class="fas fa-clock"></i></div>
            <div class="stat-info">
              <div class="stat-value"><%= stats.pending %></div>
              <div class="stat-label">Pending Review</div>
            </div>
          </div>
          <div class="stat-card stat-green">
            <div class="stat-icon"><i class="fas fa-check-circle"></i></div>
            <div class="stat-info">
              <div class="stat-value"><%= stats.accepted %></div>
              <div class="stat-label">Hired / Accepted</div>
            </div>
          </div>
          <div class="stat-card stat-red">
            <div class="stat-icon"><i class="fas fa-times-circle"></i></div>
            <div class="stat-info">
              <div class="stat-value"><%= stats.rejected %></div>
              <div class="stat-label">Rejected</div>
            </div>
          </div>
        </div>

        <!-- ── Filter & Search Toolbar ──────────────────────────────── -->
        <div class="filter-bar">
          <form action="/client/proposals" method="GET" class="filter-form">
            <!-- Project Filter Dropdown -->
            <select name="project" class="filter-select" onchange="this.form.submit()" style="flex: 1 1 200px;">
              <option value="">All Projects (<%= projects.length %>)</option>
              <% projects.forEach(pr => { %>
                <option value="<%= pr._id %>" <%= filters.project === String(pr._id) ? 'selected' : '' %>>
                  <%= pr.title.substring(0, 36) %><%= pr.title.length > 36 ? '...' : '' %> (<%= pr.status %>)
                </option>
              <% }) %>
            </select>

            <!-- Status Filter -->
            <select name="status" class="filter-select" onchange="this.form.submit()">
              <option value="">All Statuses</option>
              <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending Only</option>
              <option value="accepted" <%= filters.status === 'accepted' ? 'selected' : '' %>>Accepted / Hired</option>
              <option value="rejected" <%= filters.status === 'rejected' ? 'selected' : '' %>>Rejected</option>
            </select>

            <!-- Sort -->
            <select name="sort" class="filter-select" onchange="this.form.submit()">
              <option value="-createdAt" <%= filters.sort === '-createdAt' ? 'selected' : '' %>>Newest First</option>
              <option value="createdAt" <%= filters.sort === 'createdAt' ? 'selected' : '' %>>Oldest First</option>
              <option value="bidAmount" <%= filters.sort === 'bidAmount' ? 'selected' : '' %>>Lowest Bid</option>
              <option value="-bidAmount" <%= filters.sort === '-bidAmount' ? 'selected' : '' %>>Highest Bid</option>
            </select>

            <!-- Search input -->
            <input type="text" name="search" class="filter-input" placeholder="Search freelancer or keywords..." value="<%= filters.search || '' %>">

            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-search"></i> Search</button>
            <% if (filters.project || filters.status || filters.search || filters.sort) { %>
              <a href="/client/proposals" class="btn btn-outline btn-sm"><i class="fas fa-undo"></i> Reset</a>
            <% } %>
          </form>
        </div>

        <!-- ── Proposals List ───────────────────────────────────────── -->
        <div class="prop-hub-grid">
          <% if (proposals.length === 0) { %>
            <div class="empty-state-box full-width" style="padding:48px 20px;text-align:center;">
              <i class="fas fa-paper-plane fa-3x" style="opacity:0.35;margin-bottom:12px;color:var(--primary);"></i>
              <h3>No proposals found</h3>
              <p style="color:var(--text-muted);max-width:400px;margin:0 auto 16px;">
                <% if (filters.project || filters.status || filters.search) { %>
                  No proposals matched your selected project or search filters.
                <% } else { %>
                  Freelancers haven't submitted proposals on your projects yet.
                <% } %>
              </p>
              <% if (filters.project || filters.status || filters.search) { %>
                <a href="/client/proposals" class="btn btn-primary"><i class="fas fa-undo"></i> View All Proposals</a>
              <% } else { %>
                <a href="/client/post-project" class="btn btn-primary"><i class="fas fa-plus"></i> Post a New Project</a>
              <% } %>
            </div>
          <% } %>

          <% proposals.forEach(prop => { 
               const pProject = prop.project;
               const pFreelancer = prop.freelancer;
          %>
          <div class="prop-hub-card <%= prop.status === 'accepted' ? 'card-accepted' : (prop.status === 'rejected' ? 'card-rejected' : '') %>">
            <!-- Top Row: Project attribution & status -->
            <div class="prop-card-top">
              <div>
                <% if (pProject) { %>
                  <a href="/client/my-projects/<%= pProject._id %>/proposals" class="prop-project-badge" title="Filter to this project">
                    <i class="fas fa-folder-open"></i> <%= pProject.title %>
                  </a>
                <% } else { %>
                  <span class="badge badge-secondary">Project Deleted</span>
                <% } %>
              </div>
              <div class="prop-meta-badges">
                <% if (pProject) { %>
                  <span style="font-size:0.78rem;color:var(--text-muted);font-weight:600;">
                    Project Budget: ₹<%= (pProject.budget || 0).toLocaleString('en-IN') %>
                  </span>
                  <span class="badge status-<%= pProject.status %>" style="font-size:0.72rem;">
                    <%= pProject.status.replace('_',' ') %>
                  </span>
                <% } %>
                <span class="badge status-<%= prop.status %>" style="font-size:0.76rem;font-weight:700;">
                  <% if (prop.status === 'accepted') { %><i class="fas fa-check"></i> Accepted<% } %>
                  <% if (prop.status === 'rejected') { %><i class="fas fa-times"></i> Rejected<% } %>
                  <% if (prop.status === 'pending') { %><i class="fas fa-clock"></i> Pending<% } %>
                </span>
              </div>
            </div>

            <!-- Freelancer Info & Bid Amount -->
            <div class="prop-body-grid">
              <div class="freelancer-profile-row">
                <img src="<%= pFreelancer?.googleAvatar || '/avatar/' + (pFreelancer?._id || '') %>"
                     class="freelancer-avatar" alt="<%= pFreelancer?.name || 'Freelancer' %>"
                     onerror="this.src='/images/default-avatar.png'">
                <div class="freelancer-meta-info">
                  <a href="/client/freelancer/<%= pFreelancer?._id %>" class="freelancer-name">
                    <%= pFreelancer?.name || 'Unknown Freelancer' %>
                  </a>
                  <div class="rating-row" style="display:flex;align-items:center;gap:4px;font-size:0.8rem;">
                    <% const rScore = Math.round(pFreelancer?.rating || 5); %>
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="fas fa-star" style="color:<%= i <= rScore ? '#f59e0b' : '#cbd5e1' %>;font-size:0.75rem;"></i>
                    <% } %>
                    <span style="color:var(--text-muted);font-size:0.75rem;margin-left:4px;">
                      (<%= pFreelancer?.reviewCount || 0 %> reviews)
                    </span>
                    <% if (pFreelancer?.hourlyRate) { %>
                      <span style="color:var(--text-muted);font-size:0.75rem;">· ₹<%= pFreelancer.hourlyRate %>/hr</span>
                    <% } %>
                  </div>
                  <div class="tags-row" style="margin-top:4px;">
                    <% (pFreelancer?.skills || []).slice(0, 4).forEach(sk => { %>
                      <span class="tag" style="font-size:0.72rem;padding:2px 8px;"><%= sk %></span>
                    <% }) %>
                  </div>
                </div>
              </div>

              <!-- Bid & Timeline Box -->
              <div class="prop-bid-box">
                <div class="prop-bid-val">₹<%= (prop.bidAmount || 0).toLocaleString('en-IN') %></div>
                <div class="prop-bid-time">
                  <i class="fas fa-clock"></i> <%= prop.deliveryTime %> <%= prop.deliveryTime === 1 ? 'day' : 'days' %> delivery
                </div>
                <div style="font-size:0.72rem;color:var(--text-muted);">
                  Submitted <%= new Date(prop.createdAt).toLocaleDateString('en-IN') %>
                </div>
              </div>
            </div>

            <!-- Cover Letter -->
            <div class="prop-cover-letter">
              <h5>Cover Letter</h5>
              <p style="margin:0;"><%= prop.coverLetter %></p>
            </div>

            <!-- Action Toolbar -->
            <div class="prop-actions-bar">
              <% if (pFreelancer) { %>
                <a href="/client/freelancer/<%= pFreelancer._id %>" class="btn btn-sm btn-outline">
                  <i class="fas fa-user"></i> View Profile
                </a>
                <form action="/messages/start" method="POST" style="margin:0;">
                  <input type="hidden" name="userId" value="<%= pFreelancer._id %>">
                  <% if (pProject) { %><input type="hidden" name="projectId" value="<%= pProject._id %>"><% } %>
                  <button type="submit" class="btn btn-sm btn-primary">
                    <i class="fas fa-comment-dots"></i> Message
                  </button>
                </form>
              <% } %>

              <% if (pProject && pProject.status === 'open' && prop.status === 'pending') { %>
                <form action="/client/proposals/<%= prop._id %>/accept" method="POST" style="margin:0;">
                  <button type="submit" class="btn btn-sm btn-success"
                    onclick="return confirm('Hire <%= pFreelancer?.name || 'this freelancer' %> for ₹<%= (prop.bidAmount||0).toLocaleString('en-IN') %>?')">
                    <i class="fas fa-check"></i> Accept & Hire
                  </button>
                </form>
              <% } %>
            </div>
          </div>
          <% }) %>
        </div>

      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/theme.js"></script>
  <script>const USER_ID = '<%= currentUser._id %>';</script>
</body>
</html>
