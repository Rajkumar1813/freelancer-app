<!-- ===== UNIVERSAL REPORT VIEW POPUP MODAL ===== -->
<div class="modal-overlay report-popup-overlay" id="reportViewModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);backdrop-filter:blur(5px);z-index:9999;align-items:center;justify-content:center;padding:16px;">
  <div class="report-popup-dialog" style="background:var(--bg-card, #1a1a2e);border:1px solid var(--border);border-radius:18px;max-width:680px;width:100%;padding:24px;box-shadow:0 24px 60px rgba(0,0,0,0.5);max-height:90vh;display:flex;flex-direction:column;color:var(--text-primary);overflow:hidden;" onclick="event.stopPropagation()">
    
    <!-- Modal Header -->
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;border-bottom:1px solid var(--border);padding-bottom:14px;flex-shrink:0;">
      <div>
        <div style="display:flex;align-items:center;gap:8px;">
          <span style="background:var(--primary-light, #ede9ff);color:var(--primary);padding:6px 10px;border-radius:8px;font-size:0.9rem;">
            <i class="fas fa-file-alt"></i>
          </span>
          <h3 style="margin:0;font-size:1.15rem;font-weight:700;color:var(--text-primary);">Daily Progress Reports</h3>
        </div>
        <p style="margin:4px 0 0;font-size:0.86rem;color:var(--text-secondary);">
          Project: <strong id="reportViewProjectTitle" style="color:var(--text-primary);"></strong>
        </p>
      </div>
      <button type="button" onclick="closeReportPopup()" style="background:none;border:none;color:var(--text-muted);font-size:1.4rem;cursor:pointer;line-height:1;padding:4px 8px;border-radius:6px;" aria-label="Close">&times;</button>
    </div>

    <!-- Summary KPI Bar -->
    <div id="reportPopupKpiBar" style="display:none;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px;flex-shrink:0;">
      <div style="background:var(--secondary);border:1px solid var(--border);border-radius:10px;padding:10px 12px;text-align:center;">
        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;font-weight:600;">Reports</div>
        <div id="kpiReportCount" style="font-size:1.2rem;font-weight:700;color:var(--primary);">0</div>
      </div>
      <div style="background:var(--secondary);border:1px solid var(--border);border-radius:10px;padding:10px 12px;text-align:center;">
        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;font-weight:600;">Total Hours</div>
        <div id="kpiReportHours" style="font-size:1.2rem;font-weight:700;color:var(--info, #3b82f6);">0 hrs</div>
      </div>
      <div style="background:var(--secondary);border:1px solid var(--border);border-radius:10px;padding:10px 12px;text-align:center;">
        <div style="font-size:0.75rem;color:var(--text-muted);text-transform:uppercase;font-weight:600;">Latest Progress</div>
        <div id="kpiReportProgress" style="font-size:1.2rem;font-weight:700;color:var(--success, #22c55e);">0%</div>
      </div>
    </div>

    <!-- Scrollable Reports Timeline -->
    <div id="reportViewList" style="flex:1;overflow-y:auto;overflow-x:hidden;display:flex;flex-direction:column;gap:14px;padding-right:6px;scrollbar-width:thin;">
      <div style="text-align:center;padding:40px 16px;color:var(--text-muted);">
        <i class="fas fa-spinner fa-spin fa-2x"></i>
        <p style="margin-top:10px;">Loading reports...</p>
      </div>
    </div>

    <!-- Modal Footer -->
    <div style="margin-top:16px;padding-top:12px;border-top:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">
      <a id="reportViewFullPageLink" href="#" target="_blank" class="btn btn-sm btn-outline" style="font-size:0.82rem;display:none;">
        <i class="fas fa-external-link-alt"></i> Full Page View
      </a>
      <button type="button" onclick="closeReportPopup()" class="btn btn-primary btn-sm" style="margin-left:auto;">
        Close
      </button>
    </div>

  </div>
</div>

<script>
  // Global helpers accessible across Client & Freelancer views
  window.openReportPopup = async function (projectId, projectTitle) {
    const modal = document.getElementById('reportViewModal');
    if (!modal) return;

    const titleEl = document.getElementById('reportViewProjectTitle');
    const listEl = document.getElementById('reportViewList');
    const kpiBar = document.getElementById('reportPopupKpiBar');
    const fullLink = document.getElementById('reportViewFullPageLink');

    if (titleEl) titleEl.textContent = projectTitle || 'Project Reports';
    if (fullLink) {
      fullLink.href = '/reports/project/' + projectId;
      fullLink.style.display = 'inline-flex';
    }

    if (listEl) {
      listEl.innerHTML = `
        <div style="text-align:center;padding:40px 16px;color:var(--text-muted);">
          <i class="fas fa-spinner fa-spin fa-2x" style="color:var(--primary);"></i>
          <p style="margin-top:10px;font-size:0.9rem;">Fetching reports from server...</p>
        </div>`;
    }

    if (kpiBar) kpiBar.style.display = 'none';
    modal.style.display = 'flex';

    try {
      const res = await fetch('/reports/api/project/' + projectId);
      const data = await res.json();

      if (!data.success || !data.reports || data.reports.length === 0) {
        if (listEl) {
          listEl.innerHTML = `
            <div style="text-align:center;padding:40px 20px;color:var(--text-muted);border:1.5px dashed var(--border);border-radius:14px;background:var(--secondary);">
              <i class="fas fa-file-invoice fa-2x" style="opacity:0.4;margin-bottom:10px;color:var(--text-muted);"></i>
              <h4 style="margin:0 0 6px;color:var(--text-primary);font-size:0.95rem;">No Reports Submitted Yet</h4>
              <p style="margin:0;font-size:0.84rem;">Daily progress reports submitted by the freelancer will show up here.</p>
            </div>`;
        }
        return;
      }

      // Compute summary KPIs
      let totalHours = 0;
      data.reports.forEach(r => { totalHours += (Number(r.hoursWorked) || 0); });
      const latestProgress = data.reports[0]?.progressPercentage || 0;

      const countEl = document.getElementById('kpiReportCount');
      const hoursEl = document.getElementById('kpiReportHours');
      const progEl  = document.getElementById('kpiReportProgress');
      if (countEl) countEl.textContent = data.reports.length;
      if (hoursEl) hoursEl.textContent = totalHours.toFixed(1) + ' hrs';
      if (progEl)  progEl.textContent  = latestProgress + '%';
      if (kpiBar)  kpiBar.style.display = 'grid';

      // Render reports list
      if (listEl) {
        listEl.innerHTML = data.reports.map((r, idx) => {
          const dateStr = new Date(r.createdAt || r.date).toLocaleDateString('en-IN', {
            weekday: 'short', year: 'numeric', month: 'short', day: 'numeric'
          });
          const flName = r.freelancer?.name || 'Freelancer';
          const avatarUrl = r.freelancer?.googleAvatar || (r.freelancer?._id ? `/avatar/${r.freelancer._id}` : '/images/default-avatar.png');

          return `
            <div style="background:var(--secondary);border:1px solid var(--border);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:10px;transition:var(--transition);">
              <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
                <div style="display:flex;align-items:center;gap:8px;">
                  <img src="${avatarUrl}" loading="lazy" onerror="this.src='/images/default-avatar.png'" style="width:28px;height:28px;border-radius:50%;object-fit:cover;">
                  <div>
                    <span style="font-weight:700;font-size:0.88rem;color:var(--text-primary);">📅 ${dateStr}</span>
                    <span style="font-size:0.75rem;color:var(--text-muted);margin-left:6px;">by ${flName}</span>
                  </div>
                </div>
                <div style="display:flex;align-items:center;gap:6px;">
                  <span class="badge" style="background:rgba(59,130,246,0.15);color:#3b82f6;font-size:0.78rem;padding:3px 10px;">
                    <i class="fas fa-clock"></i> ${r.hoursWorked || 0} hrs
                  </span>
                  <span class="badge" style="background:rgba(34,197,94,0.15);color:#16a34a;font-size:0.78rem;padding:3px 10px;">
                    <i class="fas fa-tasks"></i> ${r.progressPercentage || 0}%
                  </span>
                </div>
              </div>

              <!-- Progress bar -->
              <div style="height:5px;background:var(--border);border-radius:10px;overflow:hidden;">
                <div style="width:${Math.min(100, Math.max(0, r.progressPercentage || 0))}%;background:linear-gradient(90deg, #6c63ff, #22c55e);height:100%;border-radius:10px;"></div>
              </div>

              ${r.tasksCompleted && r.tasksCompleted.length > 0 ? `
                <div style="margin-top:2px;">
                  <div style="font-size:0.74rem;text-transform:uppercase;font-weight:700;color:var(--text-muted);letter-spacing:0.04em;">Tasks Completed:</div>
                  <ul style="margin:4px 0 0 18px;padding:0;font-size:0.86rem;color:var(--text-primary);line-height:1.5;">
                    ${r.tasksCompleted.map(t => `<li>${t}</li>`).join('')}
                  </ul>
                </div>` : ''}

              ${r.tasksPlanned && r.tasksPlanned.length > 0 ? `
                <div>
                  <div style="font-size:0.74rem;text-transform:uppercase;font-weight:700;color:var(--text-muted);letter-spacing:0.04em;">Next Planned:</div>
                  <ul style="margin:4px 0 0 18px;padding:0;font-size:0.84rem;color:var(--text-secondary);line-height:1.5;">
                    ${r.tasksPlanned.map(t => `<li>${t}</li>`).join('')}
                  </ul>
                </div>` : ''}

              ${r.blockers ? `
                <div style="font-size:0.82rem;background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.25);color:#ef4444;padding:8px 12px;border-radius:8px;display:flex;align-items:center;gap:8px;">
                  <i class="fas fa-exclamation-circle" style="flex-shrink:0;"></i>
                  <span><strong>Blocker:</strong> ${r.blockers}</span>
                </div>` : ''}
            </div>
          `;
        }).join('');
      }

    } catch (err) {
      if (listEl) {
        listEl.innerHTML = `
          <div style="text-align:center;padding:30px;color:var(--danger);">
            <i class="fas fa-exclamation-triangle fa-2x"></i>
            <p style="margin-top:8px;">Failed to load reports: ${err.message}</p>
          </div>`;
      }
    }
  };

  // Alias for backward compatibility
  window.openHistoryModal = window.openReportPopup;

  window.closeReportPopup = function () {
    const modal = document.getElementById('reportViewModal');
    if (modal) modal.style.display = 'none';
  };

  // Close on backdrop click
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('reportViewModal');
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeReportPopup();
      });
    }
  });

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeReportPopup();
  });
</script>
