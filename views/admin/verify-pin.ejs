<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security Verification - Admin PIN</title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{
      font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
      background:#0a0a14;
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      overflow-x:hidden;
    }
    body::before{
      content:'';position:fixed;inset:0;
      background-image:
        linear-gradient(rgba(108,99,255,.07) 1px,transparent 1px),
        linear-gradient(90deg,rgba(108,99,255,.07) 1px,transparent 1px);
      background-size:44px 44px;pointer-events:none;z-index:0;
    }
    body::after{
      content:'';position:fixed;
      width:700px;height:700px;border-radius:50%;
      background:radial-gradient(circle,rgba(108,99,255,.13) 0%,transparent 70%);
      top:-250px;right:-250px;pointer-events:none;z-index:0;
    }
    .glow-bl{
      position:fixed;width:600px;height:600px;border-radius:50%;
      background:radial-gradient(circle,rgba(118,75,162,.10) 0%,transparent 70%);
      bottom:-200px;left:-150px;pointer-events:none;z-index:0;
    }
    .flash-wrap{position:fixed;top:20px;right:20px;z-index:999;display:flex;flex-direction:column;gap:8px;}
    .adm-flash{
      display:flex;align-items:center;gap:10px;
      padding:12px 18px;border-radius:10px;font-size:.87rem;font-weight:500;
      max-width:340px;animation:slideIn .3s ease;
    }
    .adm-flash-error{background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);color:#fca5a5;}
    .adm-flash-success{background:rgba(34,197,94,.15);border:1px solid rgba(34,197,94,.3);color:#86efac;}
    .adm-flash-close{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-left:auto;font-size:1.1rem;line-height:1;}
    @keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

    .wrap{position:relative;z-index:1;width:100%;max-width:480px;padding:24px;}
    .brand{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:28px;}
    .brand-icon{
      width:52px;height:52px;border-radius:14px;
      background:linear-gradient(135deg,#6c63ff,#764ba2);
      display:flex;align-items:center;justify-content:center;
      font-size:1.5rem;color:#fff;
      box-shadow:0 8px 24px rgba(108,99,255,.4);
    }
    .brand-text h1{font-size:1.5rem;font-weight:800;color:#fff;margin:0;}
    .brand-text span{font-size:.72rem;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.12em;font-weight:600;}

    .card{
      background:rgba(255,255,255,.04);
      border:1px solid rgba(255,255,255,.08);
      backdrop-filter:blur(20px);
      border-radius:20px;
      padding:36px;
      text-align:center;
      box-shadow:0 0 0 1px rgba(108,99,255,.08),0 32px 64px rgba(0,0,0,.5);
    }
    .shield-badge{
      width:64px;height:64px;border-radius:50%;
      background:rgba(108,99,255,.12);
      border:1px solid rgba(108,99,255,.3);
      color:#a78bfa;
      font-size:1.8rem;
      display:flex;align-items:center;justify-content:center;
      margin:0 auto 20px;
      box-shadow:0 0 20px rgba(108,99,255,.2);
      animation:pulse 2s infinite;
    }
    @keyframes pulse{
      0%,100%{transform:scale(1);}
      50%{transform:scale(1.05);box-shadow:0 0 30px rgba(108,99,255,.35);}
    }
    .card h2{font-size:1.35rem;font-weight:700;color:#fff;margin-bottom:8px;}
    .card .sub{color:rgba(255,255,255,.5);font-size:.87rem;line-height:1.5;margin-bottom:28px;}
    .email-highlight{color:#c4b5fd;font-weight:600;}

    /* OTP Inputs */
    .otp-inputs-grid{
      display:flex;
      justify-content:center;
      gap:10px;
      margin-bottom:24px;
    }
    .otp-digit{
      width:52px;height:62px;
      background:rgba(255,255,255,.06);
      border:1.5px solid rgba(255,255,255,.15);
      border-radius:12px;
      font-size:1.8rem;
      font-weight:800;
      color:#fff;
      text-align:center;
      outline:none;
      transition:all .2s;
      caret-color:#6c63ff;
      font-family:inherit;
    }
    .otp-digit:focus{
      border-color:rgba(108,99,255,.9);
      background:rgba(108,99,255,.12);
      box-shadow:0 0 0 4px rgba(108,99,255,.25);
      transform:translateY(-2px);
    }
    .otp-digit.filled{
      border-color:rgba(108,99,255,.6);
      background:rgba(108,99,255,.06);
    }

    .submit-btn{
      width:100%;padding:14px;
      background:linear-gradient(135deg,#6c63ff,#764ba2);
      border:none;border-radius:12px;color:#fff;
      font-size:.95rem;font-weight:700;cursor:pointer;
      display:flex;align-items:center;justify-content:center;gap:8px;
      transition:all .2s;
      box-shadow:0 4px 16px rgba(108,99,255,.35);
      letter-spacing:.02em;font-family:inherit;
    }
    .submit-btn:hover{transform:translateY(-1px);box-shadow:0 8px 24px rgba(108,99,255,.5);}
    .submit-btn:active{transform:translateY(0);}

    .otp-meta{
      margin-top:20px;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:12px;
      font-size:.82rem;
      color:rgba(255,255,255,.4);
    }
    .timer-wrap{
      display:inline-flex;
      align-items:center;
      gap:6px;
      color:rgba(255,255,255,.6);
    }
    .timer-wrap i{color:#6c63ff;}
    .resend-btn{
      background:none;border:none;
      color:#a78bfa;font-weight:600;
      cursor:pointer;text-decoration:underline;
      font-size:.82rem;font-family:inherit;
    }
    .resend-btn:disabled{
      color:rgba(255,255,255,.25);
      text-decoration:none;
      cursor:not-allowed;
    }
    .back-link{
      display:inline-flex;align-items:center;gap:6px;
      color:rgba(255,255,255,.4);text-decoration:none;
      font-size:.8rem;margin-top:16px;
      transition:color .2s;
    }
    .back-link:hover{color:#fff;}
  </style>
</head>
<body>
  <div class="glow-bl"></div>

  <!-- Flash messages -->
  <div class="flash-wrap">
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
      <% success.forEach(msg => { %>
        <div class="adm-flash adm-flash-success">
          <i class="fas fa-check-circle"></i> <%= msg %>
          <button class="adm-flash-close" onclick="this.parentElement.remove()">×</button>
        </div>
      <% }) %>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <% error.forEach(msg => { %>
        <div class="adm-flash adm-flash-error">
          <i class="fas fa-exclamation-circle"></i> <%= msg %>
          <button class="adm-flash-close" onclick="this.parentElement.remove()">×</button>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="wrap">
    <div class="brand">
      <div class="brand-icon"><i class="fas fa-shield-halved"></i></div>
      <div class="brand-text">
        <h1>FreelanceHub</h1>
        <span>Security Verification</span>
      </div>
    </div>

    <div class="card">
      <div class="shield-badge">
        <i class="fas fa-key"></i>
      </div>
      <h2>Two-Factor Security PIN</h2>
      <p class="sub">
        Enter the 6-digit administrative security PIN to authenticate session for
        <span class="email-highlight"><%= typeof adminEmail !== 'undefined' ? adminEmail : 'Authorized Admin' %></span>.
      </p>

      <form action="/auth/admin/verify-pin" method="POST" id="pinForm">
        <input type="hidden" name="pin" id="fullPin">
        <div class="otp-inputs-grid">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autofocus autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
        </div>

        <button type="submit" class="submit-btn" id="verifyBtn">
          <i class="fas fa-shield-check"></i> Authorize & Enter Panel
        </button>
      </form>

      <div class="otp-meta">
        <div class="timer-wrap">
          <i class="fas fa-stopwatch"></i>
          <span>Security session active: <strong id="timerDisplay">02:00</strong></span>
        </div>
        <p style="font-size:0.75rem;opacity:0.6;margin:0;">
          Code sent to device • Protected by encrypted 2FA gateway
        </p>
      </div>

      <a href="/auth/admin/login" class="back-link">
        <i class="fas fa-arrow-left"></i> Cancel and return to sign in
      </a>
    </div>
  </div>

  <script>
    const inputs = document.querySelectorAll('.otp-digit');
    const form = document.getElementById('pinForm');
    const fullPinInput = document.getElementById('fullPin');

    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.replace(/[^0-9]/g, '');
        e.target.value = val;
        if (val) {
          input.classList.add('filled');
          if (index < inputs.length - 1) {
            inputs[index + 1].focus();
          }
        } else {
          input.classList.remove('filled');
        }
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          inputs[index - 1].focus();
        }
      });

      // Handle paste of 6 digits
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim();
        const digits = pasteData.replace(/[^0-9]/g, '').slice(0, 6);
        digits.split('').forEach((digit, i) => {
          if (inputs[i]) {
            inputs[i].value = digit;
            inputs[i].classList.add('filled');
          }
        });
        if (inputs[Math.min(digits.length, 5)]) {
          inputs[Math.min(digits.length, 5)].focus();
        }
      });
    });

    form.addEventListener('submit', (e) => {
      let pin = '';
      inputs.forEach(input => pin += input.value);
      if (pin.length !== 6) {
        e.preventDefault();
        alert('Please enter all 6 digits of your Security PIN.');
        return;
      }
      fullPinInput.value = pin;
    });

    // 2-minute countdown timer
    let timeLeft = 120;
    const timerDisplay = document.getElementById('timerDisplay');
    const timerInterval = setInterval(() => {
      timeLeft--;
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        timerDisplay.textContent = 'Expired';
      } else {
        const mins = String(Math.floor(timeLeft / 60)).padStart(2, '0');
        const secs = String(timeLeft % 60).padStart(2, '0');
        timerDisplay.textContent = `${mins}:${secs}`;
      }
    }, 1000);
  </script>
</body>
</html>
