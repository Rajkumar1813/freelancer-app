<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Security Verification - Admin PIN</title>
  <script src="/js/theme.js"></script>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    :root {
      --v-bg: #0a0a14;
      --v-card: rgba(20, 20, 38, 0.95);
      --v-border: rgba(255, 255, 255, 0.12);
      --v-text-title: #ffffff;
      --v-text-sub: rgba(255, 255, 255, 0.72);
      --v-text-muted: rgba(255, 255, 255, 0.5);
      --v-input-bg: rgba(255, 255, 255, 0.08);
      --v-input-border: rgba(255, 255, 255, 0.2);
      --v-input-text: #ffffff;
      --v-shadow: 0 24px 60px rgba(0,0,0,0.5);
    }
    [data-theme="light"] {
      --v-bg: #f3f5f9;
      --v-card: #ffffff;
      --v-border: #e2e8f0;
      --v-text-title: #0f172a;
      --v-text-sub: #334155;
      --v-text-muted: #64748b;
      --v-input-bg: #f8fafc;
      --v-input-border: #cbd5e1;
      --v-input-text: #0f172a;
      --v-shadow: 0 20px 45px rgba(108, 99, 255, 0.12);
    }
    body{
      font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
      background:var(--v-bg);
      color:var(--v-text-title);
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      position:relative;
      overflow-x:hidden;
      transition:background .2s, color .2s;
    }
    body::before{
      content:'';position:fixed;inset:0;
      background-image:
        linear-gradient(rgba(108,99,255,.07) 1px,transparent 1px),
        linear-gradient(90deg,rgba(108,99,255,.07) 1px,transparent 1px);
      background-size:44px 44px;pointer-events:none;z-index:0;
    }
    body::after{
      content:'';position:fixed;
      width:700px;height:700px;border-radius:50%;
      background:radial-gradient(circle,rgba(108,99,255,.14) 0%,transparent 70%);
      top:-250px;right:-250px;pointer-events:none;z-index:0;
    }
    .glow-bl{
      position:fixed;width:600px;height:600px;border-radius:50%;
      background:radial-gradient(circle,rgba(118,75,162,.10) 0%,transparent 70%);
      bottom:-200px;left:-150px;pointer-events:none;z-index:0;
    }
    .flash-wrap{position:fixed;top:20px;right:20px;z-index:999;display:flex;flex-direction:column;gap:8px;}
    .adm-flash{
      display:flex;align-items:center;gap:10px;
      padding:12px 18px;border-radius:10px;font-size:.87rem;font-weight:500;
      max-width:340px;animation:slideIn .3s ease;
    }
    .adm-flash-error{background:rgba(239,68,68,.15);border:1px solid rgba(239,68,68,.3);color:#ef4444;}
    .adm-flash-success{background:rgba(34,197,94,.15);border:1px solid rgba(34,197,94,.3);color:#10b981;}
    .adm-flash-close{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-left:auto;font-size:1.1rem;line-height:1;}
    @keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}

    .wrap{position:relative;z-index:1;width:100%;max-width:480px;padding:24px;}
    .brand{display:flex;align-items:center;justify-content:center;gap:12px;margin-bottom:28px;}
    .brand-icon{
      width:52px;height:52px;border-radius:14px;
      background:linear-gradient(135deg,#6c63ff,#764ba2);
      display:flex;align-items:center;justify-content:center;
      font-size:1.5rem;color:#fff;
      box-shadow:0 8px 24px rgba(108,99,255,.4);
    }
    .brand-text h1{font-size:1.55rem;font-weight:800;color:var(--v-text-title)!important;margin:0;letter-spacing:-.3px;}
    .brand-text span{font-size:.74rem;color:var(--v-text-muted)!important;text-transform:uppercase;letter-spacing:.12em;font-weight:700;}

    .card{
      background:var(--v-card)!important;
      border:1.5px solid var(--v-border)!important;
      backdrop-filter:blur(20px);
      border-radius:22px;
      padding:36px;
      text-align:center;
      box-shadow:var(--v-shadow)!important;
      transition:all .25s ease;
    }
    .shield-badge{
      width:68px;height:68px;border-radius:50%;
      background:rgba(108,99,255,.14);
      border:1.5px solid rgba(108,99,255,.35);
      color:#6c63ff;
      font-size:1.9rem;
      display:flex;align-items:center;justify-content:center;
      margin:0 auto 20px;
      box-shadow:0 0 24px rgba(108,99,255,.25);
      animation:pulse 2s infinite;
    }
    @keyframes pulse{
      0%,100%{transform:scale(1);}
      50%{transform:scale(1.05);box-shadow:0 0 32px rgba(108,99,255,.35);}
    }
    .card h2{font-size:1.45rem;font-weight:800;color:var(--v-text-title)!important;margin-bottom:8px;letter-spacing:-.3px;}
    .card .sub{color:var(--v-text-sub)!important;font-size:.9rem;line-height:1.55;margin-bottom:28px;}
    .email-highlight{color:#6c63ff;font-weight:700;}

    /* OTP Inputs */
    .otp-inputs-grid{
      display:flex;
      justify-content:center;
      gap:10px;
      margin-bottom:24px;
    }
    .otp-digit{
      width:54px;height:64px;
      background:var(--v-input-bg)!important;
      border:2px solid var(--v-input-border)!important;
      border-radius:14px;
      font-size:1.9rem;
      font-weight:800;
      color:var(--v-input-text)!important;
      text-align:center;
      outline:none;
      transition:all .2s;
      caret-color:#6c63ff;
      font-family:inherit;
    }
    .otp-digit:focus{
      border-color:#6c63ff!important;
      background:var(--v-input-bg)!important;
      box-shadow:0 0 0 4px rgba(108,99,255,.2)!important;
      transform:translateY(-2px);
    }
    .otp-digit.filled{
      border-color:#6c63ff!important;
      background:rgba(108,99,255,.08)!important;
    }

    .submit-btn{
      width:100%;padding:14px;
      background:linear-gradient(135deg,#6c63ff,#764ba2);
      border:none;border-radius:12px;color:#fff;
      font-size:.98rem;font-weight:700;cursor:pointer;
      display:flex;align-items:center;justify-content:center;gap:8px;
      transition:all .2s;
      box-shadow:0 6px 20px rgba(108,99,255,.38);
      letter-spacing:.02em;font-family:inherit;
    }
    .submit-btn:hover{transform:translateY(-1px);box-shadow:0 10px 28px rgba(108,99,255,.55);}
    .submit-btn:active{transform:translateY(0);}
    .submit-btn:disabled{opacity:0.75;cursor:not-allowed;}

    .otp-meta{
      margin-top:20px;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:10px;
      font-size:.84rem;
      color:var(--v-text-muted);
    }
    .timer-wrap{
      display:inline-flex;
      align-items:center;
      gap:6px;
      color:var(--v-text-sub);
      font-weight:600;
    }
    .timer-wrap i{color:#6c63ff;}
    .back-link{
      display:inline-flex;align-items:center;gap:6px;
      color:var(--v-text-muted)!important;text-decoration:none;
      font-size:.84rem;margin-top:16px;
      font-weight:600;
      transition:color .2s;
    }
    .back-link:hover{color:#6c63ff!important;}
    .auto-submit-hint{
      font-size:0.78rem;
      color:var(--v-text-muted);
      margin-top:6px;
    }
  </style>
</head>
<body>
  <div class="glow-bl"></div>

  <!-- Flash messages -->
  <div class="flash-wrap">
    <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
      <% success.forEach(msg => { %>
        <div class="adm-flash adm-flash-success">
          <i class="fas fa-check-circle"></i> <%= msg %>
          <button class="adm-flash-close" onclick="this.parentElement.remove()">×</button>
        </div>
      <% }) %>
    <% } %>
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
      <% error.forEach(msg => { %>
        <div class="adm-flash adm-flash-error">
          <i class="fas fa-exclamation-circle"></i> <%= msg %>
          <button class="adm-flash-close" onclick="this.parentElement.remove()">×</button>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="wrap">
    <div class="brand">
      <div class="brand-icon"><i class="fas fa-shield-halved"></i></div>
      <div class="brand-text">
        <h1>FreelanceHub</h1>
        <span>Security Verification</span>
      </div>
    </div>

    <div class="card">
      <div class="shield-badge">
        <i class="fas fa-key"></i>
      </div>
      <h2>Two-Factor Security PIN</h2>
      <p class="sub">
        Enter the 6-digit administrative security PIN to authenticate session for
        <span class="email-highlight"><%= typeof adminEmail !== 'undefined' ? adminEmail : 'Authorized Admin' %></span>.
      </p>

      <form action="/auth/admin/verify-pin" method="POST" id="pinForm">
        <input type="hidden" name="pin" id="fullPin">
        <div class="otp-inputs-grid">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autofocus autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
          <input type="text" class="otp-digit" maxlength="1" inputmode="numeric" pattern="[0-9]*" autocomplete="off">
        </div>

        <button type="submit" class="submit-btn" id="verifyBtn">
          <i class="fas fa-shield-check"></i> Authorize & Enter Panel
        </button>
        <p class="auto-submit-hint"><i class="fas fa-magic"></i> Auto-verifies instantly upon entering all 6 digits</p>
      </form>

      <div class="otp-meta">
        <div class="timer-wrap">
          <i class="fas fa-stopwatch"></i>
          <span>Security session active: <strong id="timerDisplay">02:00</strong></span>
        </div>
        <p style="font-size:0.75rem;margin:0;">
          Protected by FreelanceHub 2FA Gateway
        </p>
      </div>

      <a href="/auth/admin/login" class="back-link">
        <i class="fas fa-arrow-left"></i> Cancel and return to sign in
      </a>
    </div>
  </div>

  <script>
    const inputs = document.querySelectorAll('.otp-digit');
    const form = document.getElementById('pinForm');
    const fullPinInput = document.getElementById('fullPin');
    const verifyBtn = document.getElementById('verifyBtn');

    function checkAndAutoSubmit() {
      let pin = '';
      inputs.forEach(inp => pin += inp.value.trim());
      if (pin.length === 6) {
        fullPinInput.value = pin;
        verifyBtn.disabled = true;
        verifyBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Authorizing Admin...';
        // Auto submit instantly without needing to press the button
        setTimeout(() => {
          form.submit();
        }, 120);
      }
    }

    inputs.forEach((input, index) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.replace(/[^0-9]/g, '');
        e.target.value = val;
        if (val) {
          input.classList.add('filled');
          if (index < inputs.length - 1) {
            inputs[index + 1].focus();
          }
        } else {
          input.classList.remove('filled');
        }
        checkAndAutoSubmit();
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && index > 0) {
          inputs[index - 1].focus();
        }
      });

      // Handle paste of 6 digits
      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const pasteData = (e.clipboardData || window.clipboardData).getData('text').trim();
        const digits = pasteData.replace(/[^0-9]/g, '').slice(0, 6);
        digits.split('').forEach((digit, i) => {
          if (inputs[i]) {
            inputs[i].value = digit;
            inputs[i].classList.add('filled');
          }
        });
        if (inputs[Math.min(digits.length, 5)]) {
          inputs[Math.min(digits.length, 5)].focus();
        }
        checkAndAutoSubmit();
      });
    });

    form.addEventListener('submit', (e) => {
      let pin = '';
      inputs.forEach(input => pin += input.value);
      if (pin.length !== 6) {
        e.preventDefault();
        alert('Please enter all 6 digits of your Security PIN.');
        return;
      }
      fullPinInput.value = pin;
    });

    // 2-minute countdown timer
    let timeLeft = 120;
    const timerDisplay = document.getElementById('timerDisplay');
    const timerInterval = setInterval(() => {
      timeLeft--;
      if (timeLeft <= 0) {
        clearInterval(timerInterval);
        timerDisplay.textContent = 'Expired';
      } else {
        const mins = String(Math.floor(timeLeft / 60)).padStart(2, '0');
        const secs = String(timeLeft % 60).padStart(2, '0');
        timerDisplay.textContent = `${mins}:${secs}`;
      }
    }, 1000);
  </script>
</body>
</html>
