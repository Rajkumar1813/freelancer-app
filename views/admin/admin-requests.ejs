<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link rel="stylesheet" href="/css/theme.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="app-body">
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="page-header">
        <div>
          <h1 class="page-title"><i class="fas fa-user-shield"></i> Admin Authorization Requests</h1>
          <p class="page-subtitle">Manage administrative privileges and review new admin registrations</p>
        </div>
      </div>

      <div class="table-card">
        <div class="table-header">
          <h3>Administrators & Approval Requests (<%= admins.length %>)</h3>
        </div>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Administrator</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th>Registered</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (admins.length === 0) { %>
                <tr>
                  <td colspan="6" class="empty-state">No administrators found</td>
                </tr>
              <% } %>
              <% admins.forEach(admin => { %>
                <tr>
                  <td>
                    <div class="user-cell">
                      <img src="<%= admin.googleAvatar || (admin.avatar ? '/avatar/' + admin._id : '/images/default-avatar.png') %>"
                           class="table-avatar" alt="<%= admin.name %>" onerror="this.src='/images/default-avatar.png'">
                      <div>
                        <strong><%= admin.name %></strong>
                        <% if (admin.email === 'fileshare1813@gmail.com') { %>
                          <span style="background:linear-gradient(135deg,#6c63ff,#764ba2);color:#fff;font-size:0.65rem;padding:2px 6px;border-radius:10px;font-weight:700;margin-left:4px;">SUPER ADMIN</span>
                        <% } %>
                      </div>
                    </div>
                  </td>
                  <td><%= admin.email %></td>
                  <td><span class="badge role-admin">admin</span></td>
                  <td>
                    <% if (admin.adminApproved) { %>
                      <span class="badge" style="background:rgba(34,197,94,0.15);color:var(--success);border:1px solid rgba(34,197,94,0.3);">
                        <i class="fas fa-check-circle"></i> Approved
                      </span>
                    <% } else { %>
                      <span class="badge" style="background:rgba(245,158,11,0.15);color:var(--warning);border:1px solid rgba(245,158,11,0.3);">
                        <i class="fas fa-clock"></i> Pending Review
                      </span>
                    <% } %>
                  </td>
                  <td><%= new Date(admin.createdAt).toLocaleDateString('en-IN') %></td>
                  <td>
                    <div class="action-btns">
                      <% if (admin.email === 'fileshare1813@gmail.com') { %>
                        <span style="font-size:0.8rem;color:var(--text-muted);font-weight:600;"><i class="fas fa-lock"></i> Protected</span>
                      <% } else if (!admin.adminApproved) { %>
                        <form action="/admin/admin-requests/<%= admin._id %>/approve" method="POST" style="display:inline;">
                          <button type="submit" class="btn btn-sm btn-primary" title="Approve Admin Access">
                            <i class="fas fa-check"></i> Approve
                          </button>
                        </form>
                        <form action="/admin/admin-requests/<%= admin._id %>/reject" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to reject and delete this admin request?')">
                          <button type="submit" class="btn btn-sm btn-danger" title="Reject Request">
                            <i class="fas fa-times"></i> Reject
                          </button>
                        </form>
                      <% } else { %>
                        <form action="/admin/admin-requests/<%= admin._id %>/reject" method="POST" style="display:inline;" onsubmit="return confirm('Revoke admin access for this user?')">
                          <button type="submit" class="btn btn-sm btn-danger" title="Revoke Admin Access">
                            <i class="fas fa-user-slash"></i> Revoke
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
