<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <script src="/socket.io/socket.io.js"></script>
</head>
<body class="app-body">
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>
  <div class="app-layout">
    <%- include('../partials/sidebar') %>
    <main class="main-content">
      <div class="page-header">
        <div><h1 class="page-title">Manage Users</h1><p class="page-subtitle">All registered users on the platform</p></div>
      </div>
      <!-- Filters -->
      <div class="filter-bar">
        <form action="/admin/users" method="GET" class="filter-form">
          <input type="text" name="search" placeholder="Search by name or email..." class="filter-input" value="<%= filters.search || '' %>">
          <select name="role" class="filter-select">
            <option value="">All Roles</option>
            <option value="client" <%= filters.role === 'client' ? 'selected' : '' %>>Client</option>
            <option value="freelancer" <%= filters.role === 'freelancer' ? 'selected' : '' %>>Freelancer</option>
          </select>
          <select name="status" class="filter-select">
            <option value="">All Status</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="banned" <%= filters.status === 'banned' ? 'selected' : '' %>>Banned</option>
          </select>
          <select name="sort" class="filter-select">
            <option value="-createdAt" <%= filters.sort === '-createdAt' ? 'selected' : '' %>>Newest First</option>
            <option value="createdAt" <%= filters.sort === 'createdAt' ? 'selected' : '' %>>Oldest First</option>
            <option value="-rating" <%= filters.sort === '-rating' ? 'selected' : '' %>>Top Rated</option>
          </select>
          <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Filter</button>
          <a href="/admin/users" class="btn btn-outline">Clear</a>
        </form>
      </div>
      <div class="table-card">
        <div class="table-header">
          <h3>Users (<%= users.length %>)</h3>
        </div>
        <table class="data-table">
          <thead>
            <tr>
              <th>User</th>
              <th>Role</th>
              <th>Login Type</th>
              <th>Password</th>
              <th>Email</th>
              <th>Joined</th>
              <th>Projects</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
            <tr>
              <td>
                <div class="user-cell">
                  <img src="<%= u.googleAvatar || '/avatar/' + u._id %>" class="table-avatar" onerror="this.src='/images/default-avatar.png'">
                  <div>
                    <div class="fw-bold"><%= u.name %></div>
                    <div class="text-muted small"><%= u.location || '' %></div>
                  </div>
                </div>
              </td>
              <td><span class="badge role-<%= u.role %>"><%= u.role %></span></td>
              <td>
                <% if (u.authProvider === 'google' || u.googleId) { %>
                  <span class="badge" style="background:rgba(66,133,244,0.12);color:#4285f4;border:1px solid rgba(66,133,244,0.3);font-size:0.78rem;font-weight:700;">
                    <i class="fab fa-google"></i> Google Login
                  </span>
                <% } else { %>
                  <span class="badge" style="background:rgba(108,99,255,0.12);color:#6c63ff;border:1px solid rgba(108,99,255,0.3);font-size:0.78rem;font-weight:700;">
                    <i class="fas fa-envelope"></i> Manual Account
                  </span>
                <% } %>
              </td>
              <td>
                <% if (u.authProvider === 'google' || (u.googleId && !u.rawPassword && !u.password)) { %>
                  <span class="text-muted small" style="font-style:italic;">
                    <i class="fab fa-google" style="color:#4285f4;"></i> None (Google)
                  </span>
                <% } else { %>
                  <div style="display:inline-flex;align-items:center;gap:6px;background:rgba(108,99,255,0.06);padding:3px 8px;border-radius:6px;border:1px solid var(--border);">
                    <span id="pw-txt-<%= u._id %>" style="font-family:monospace;font-size:0.86rem;font-weight:700;letter-spacing:1px;color:var(--text-primary);">••••••••</span>
                    <button type="button" onclick="toggleUserPw('<%= u._id %>', '<%= (u.rawPassword || 'Password@123').replace(/'/g, '') %>')"
                      style="background:none;border:none;color:#6c63ff;cursor:pointer;padding:2px 4px;font-size:0.85rem;" title="Show/Hide Password">
                      <i class="fas fa-eye" id="pw-eye-<%= u._id %>"></i>
                    </button>
                    <button type="button" onclick="copyUserPw('<%= (u.rawPassword || 'Password@123').replace(/'/g, '') %>')"
                      style="background:none;border:none;color:var(--text-muted);cursor:pointer;padding:2px 4px;font-size:0.82rem;" title="Copy Password">
                      <i class="fas fa-copy"></i>
                    </button>
                  </div>
                <% } %>
              </td>
              <td class="text-muted"><%= u.email %></td>
              <td><%= new Date(u.createdAt).toLocaleDateString('en-IN') %></td>
              <td><%= u.completedProjects || 0 %> done</td>
              <td>
                <% if (u.isBanned) { %><span class="badge badge-danger">Banned</span>
                <% } else if (u.isVerified) { %><span class="badge badge-success">Active</span>
                <% } else { %><span class="badge badge-warning">Unverified</span><% } %>
              </td>
              <td>
                <div class="action-btns">
                  <a href="/profile/<%= u._id %>" class="btn btn-sm btn-outline" title="View Profile"><i class="fas fa-eye"></i></a>
                  <button type="button" onclick="openResetPwModal('<%= u._id %>', '<%= u.name.replace(/'/g, '') %>')" class="btn btn-sm btn-outline" title="Set New Password">
                    <i class="fas fa-key"></i>
                  </button>
                  <form action="/admin/users/<%= u._id %>/ban" method="POST" style="display:inline">
                    <button type="submit" class="btn btn-sm <%= u.isBanned ? 'btn-success' : 'btn-warning' %>" 
                      onclick="return confirm('<%= u.isBanned ? 'Unban' : 'Ban' %> this user?')"
                      title="<%= u.isBanned ? 'Unban' : 'Ban' %>">
                      <i class="fas <%= u.isBanned ? 'fa-unlock' : 'fa-ban' %>"></i>
                    </button>
                  </form>
                  <form action="/admin/users/<%= u._id %>/delete" method="POST" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this user permanently?')" title="Delete">
                      <i class="fas fa-trash"></i>
                    </button>
                  </form>
                  <% if (typeof isSuperAdmin !== 'undefined' && isSuperAdmin) { %>
                    <button type="button" onclick="openMakeManagerModal('<%= u._id %>', '<%= u.name.replace(/'/g, '') %>')" 
                      class="btn btn-sm btn-outline" style="color:#0284c7;border-color:rgba(2,132,199,0.4);" title="Promote to Manager">
                      <i class="fas fa-user-shield"></i>
                    </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
            <% if (users.length === 0) { %>
              <tr><td colspan="9" class="empty-state">Users Not found</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <!-- Admin Reset User Password Modal -->
  <div class="modal-overlay" id="resetPwModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;">
    <div style="background:var(--bg-card,#18182f);border:1px solid var(--border);border-radius:16px;max-width:420px;width:100%;padding:24px;box-shadow:0 20px 40px rgba(0,0,0,0.5);">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <h3 style="margin:0;font-size:1.15rem;display:flex;align-items:center;gap:8px;">
          <i class="fas fa-key" style="color:#6c63ff;"></i> Reset Password
        </h3>
        <button onclick="closeResetPwModal()" style="background:none;border:none;color:var(--text-muted);font-size:1.2rem;cursor:pointer;">×</button>
      </div>
      <form id="resetPwForm" method="POST">
        <p style="font-size:0.88rem;color:var(--text-secondary);margin-bottom:14px;">
          Set a new manual password for <strong id="resetTargetName"></strong>:
        </p>
        <div style="margin-bottom:16px;">
          <label style="display:block;font-size:0.8rem;font-weight:700;color:var(--text-muted);margin-bottom:6px;text-transform:uppercase;">New Password</label>
          <input type="text" name="newPassword" id="modalNewPwInput" class="form-input" style="width:100%;padding:10px;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--text-primary);" placeholder="Enter new password (min 6 chars)" required minlength="6">
        </div>
        <div style="display:flex;justify-content:flex-end;gap:10px;">
          <button type="button" onclick="closeResetPwModal()" class="btn btn-outline btn-sm">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-check"></i> Save New Password</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Make Manager Modal (Super Admin) -->
  <div class="modal-overlay" id="makeManagerModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:9999;align-items:center;justify-content:center;padding:16px;">
    <div style="background:var(--bg-card,#18182f);border:1px solid var(--border);border-radius:16px;max-width:520px;width:100%;padding:24px;box-shadow:0 24px 48px rgba(0,0,0,0.5);max-height:92vh;overflow-y:auto;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;border-bottom:1px solid var(--border);padding-bottom:10px;">
        <h3 style="margin:0;font-size:1.15rem;display:flex;align-items:center;gap:8px;color:var(--text-primary);">
          <i class="fas fa-user-shield" style="color:#0284c7;"></i> Promote to Manager
        </h3>
        <button onclick="closeMakeManagerModal()" style="background:none;border:none;color:var(--text-muted);font-size:1.2rem;cursor:pointer;">&times;</button>
      </div>
      <form id="makeManagerForm" method="POST">
        <p style="font-size:0.88rem;color:var(--text-secondary);margin-bottom:14px;">
          Assign manager features to <strong id="makeManagerName" style="color:var(--text-primary);"></strong>:
        </p>
        
        <div style="display:flex;flex-direction:column;gap:8px;background:var(--secondary);padding:14px;border-radius:10px;border:1px solid var(--border);margin-bottom:18px;">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:0.88rem;color:var(--text-primary);">
            <input type="checkbox" name="manageUsers" style="width:16px;height:16px;accent-color:var(--primary);">
            <span><strong>👥 Manage Users</strong> — User accounts & passwords</span>
          </label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:0.88rem;color:var(--text-primary);">
            <input type="checkbox" name="manageProjects" checked style="width:16px;height:16px;accent-color:var(--primary);">
            <span><strong>📁 Manage Projects</strong> — Moderation & milestones</span>
          </label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:0.88rem;color:var(--text-primary);">
            <input type="checkbox" name="managePayments" style="width:16px;height:16px;accent-color:var(--primary);">
            <span><strong>💳 Payments & Escrow</strong> — View transactions & escrow release</span>
          </label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:0.88rem;color:var(--text-primary);">
            <input type="checkbox" name="manageUnverified" style="width:16px;height:16px;accent-color:var(--primary);">
            <span><strong>⏱️ Unverified Users</strong> — Verification overview</span>
          </label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:0.88rem;color:var(--text-primary);">
            <input type="checkbox" name="viewAnalytics" checked style="width:16px;height:16px;accent-color:var(--primary);">
            <span><strong>📊 Analytics & Growth</strong> — Charts & statistics</span>
          </label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:0.88rem;color:var(--text-primary);">
            <input type="checkbox" name="accessMessages" checked style="width:16px;height:16px;accent-color:var(--primary);">
            <span><strong>💬 Support Chat</strong> — Read & send messages</span>
          </label>
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:0.88rem;color:var(--text-primary);">
            <input type="checkbox" name="manageSettings" style="width:16px;height:16px;accent-color:var(--primary);">
            <span><strong>⚙️ Platform Settings</strong> — Operational config</span>
          </label>
        </div>

        <div style="display:flex;justify-content:flex-end;gap:10px;">
          <button type="button" onclick="closeMakeManagerModal()" class="btn btn-outline btn-sm">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-check"></i> Save & Promote</button>
        </div>
      </form>
    </div>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/notifications.js"></script>
  <script src="/js/theme.js"></script>
  <script>
    const USER_ID = '<%= currentUser._id %>';

    function toggleUserPw(userId, realPassword) {
      const txt = document.getElementById('pw-txt-' + userId);
      const eye = document.getElementById('pw-eye-' + userId);
      if (!txt || !eye) return;

      if (txt.textContent === '••••••••') {
        txt.textContent = realPassword;
        eye.className = 'fas fa-eye-slash';
      } else {
        txt.textContent = '••••••••';
        eye.className = 'fas fa-eye';
      }
    }

    function copyUserPw(password) {
      navigator.clipboard.writeText(password).then(() => {
        alert('Password copied to clipboard!');
      }).catch(() => {
        prompt('Copy password:', password);
      });
    }

    function openResetPwModal(userId, userName) {
      document.getElementById('resetPwForm').action = '/admin/users/' + userId + '/reset-password';
      document.getElementById('resetTargetName').textContent = userName;
      document.getElementById('modalNewPwInput').value = '';
      document.getElementById('resetPwModal').style.display = 'flex';
    }

    function closeResetPwModal() {
      document.getElementById('resetPwModal').style.display = 'none';
    }

    function openMakeManagerModal(userId, userName) {
      document.getElementById('makeManagerForm').action = '/admin/team/promote/' + userId;
      document.getElementById('makeManagerName').textContent = userName;
      document.getElementById('makeManagerModal').style.display = 'flex';
    }

    function closeMakeManagerModal() {
      document.getElementById('makeManagerModal').style.display = 'none';
    }
  </script>
</body>
</html>